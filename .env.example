# ---- Core ----
NODE_ENV=development
PORT=4000
# Public URL of this API (used in links/webhooks)
PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://commerce:commerce_dev_only@localhost:55440/commerce?schema=public
# Comma-separated allowlist of browser origins (storefront + admin). No wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-long-random-string-min-32-chars
COOKIE_SECURE=false
COOKIE_DOMAIN=
LOG_LEVEL=info

# ---- First admin (used by `npm run create-admin`; never commit real values) ----
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# ---- Storage ----
STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Payments ----
PAYMENT_PROVIDER=MOCK            # MOCK | MANUAL | RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shipping ----
SHIPPING_PROVIDER=MANUAL         # MANUAL | MOCK | SHIPROCKET
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ---- Email ----
EMAIL_PROVIDER=LOG               # LOG | SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=store@example.com

# ---- Admin (build-time) ----
VITE_API_URL=http://localhost:4000

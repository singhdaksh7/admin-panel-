// Kash Commerce core schema. ONE DEPLOYMENT = ONE STORE. There is intentionally no tenantId.
// Money: Decimal(12,2). Never Float. Orders snapshot everything they need (immutable).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Auth / RBAC ─────────────────────────

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. products.write
  description String?
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // SUPER_ADMIN, ADMIN, ...
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  admins      AdminUser[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminUser {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String
  roleId             String
  role               Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive           Boolean              @default(true)
  failedLoginCount   Int                  @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           AdminSession[]
  resetTokens        AdminPasswordReset[]
  auditLogs          AuditLog[]

  @@index([roleId])
}

model AdminSession {
  id               String    @id @default(cuid())
  adminUserId      String
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  familyId         String // rotation family; reuse of a rotated token revokes the family
  csrfToken        String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([adminUserId])
  @@index([familyId])
  @@index([expiresAt])
}

model AdminPasswordReset {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String // e.g. product.update
  entityType String
  entityId   String?
  summary    Json? // safe before/after summary, never secrets
  requestId  String?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ───────────────────────── Store config ─────────────────────────

/// Singleton row (id = "store").
model StoreSettings {
  id            String   @id @default("store")
  name          String   @default("My Store")
  legalName     String?
  logoMediaId   String?
  faviconMediaId String?
  supportEmail  String?
  phone         String?
  address       Json? // { line1, line2, city, state, postalCode, country }
  currency      String   @default("USD") // ISO 4217
  locale        String   @default("en-US")
  timezone      String   @default("UTC")
  tax           Json     @default("{}") // { mode: NONE|EXCLUSIVE|INCLUSIVE|INDIA_GST, gstin, homeState, defaultRate, pricesIncludeTax }
  checkout      Json     @default("{}") // { guestCheckout, requirePhone, minOrderAmount, ... }
  features      Json     @default("{}") // { customerAccounts, reviews, blog, coupons, inventory }
  social        Json     @default("{}")
  updatedAt     DateTime @updatedAt
}

/// Non-secret provider configuration. Secrets live in env vars ONLY.
model IntegrationSetting {
  id        String   @id @default(cuid())
  kind      String // PAYMENT | SHIPPING | NOTIFICATION | STORAGE
  provider  String // RAZORPAY | MANUAL | MOCK | SHIPROCKET | S3 | LOCAL | SMTP ...
  enabled   Boolean  @default(false)
  isDefault Boolean  @default(false)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([kind, provider])
}

// ───────────────────────── Media ─────────────────────────

model Media {
  id           String         @id @default(cuid())
  storageKey   String         @unique
  provider     String // LOCAL | S3
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  checksum     String?
  createdAt    DateTime       @default(now())
  productImages ProductImage[]

  @@index([createdAt])
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id          String     @id @default(cuid())
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  name        String
  slug        String     @unique
  description String?
  imageMediaId  String?
  bannerMediaId String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  seo         Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  filterGroups FilterGroup[]
  couponLinks CouponCategory[]

  @@index([parentId, sortOrder])
}

enum CollectionType {
  MANUAL
  RULE
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  type        CollectionType      @default(MANUAL)
  rules       Json? // rule-capable architecture: { match: "all"|"any", conditions: [...] }
  imageMediaId String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  seo         Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model TaxClass {
  id       String    @id @default(cuid())
  name     String    @unique
  rate     Decimal   @db.Decimal(6, 3) // percent
  hsnCode  String?
  products Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String             @id @default(cuid())
  title            String
  slug             String             @unique
  shortDescription String?
  description      String? // rich text (HTML sanitized on write)
  status           ProductStatus      @default(DRAFT)
  categoryId       String?
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxClassId       String?
  taxClass         TaxClass?          @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  brand            String?
  isFeatured       Boolean            @default(false)
  isNew            Boolean            @default(false)
  publishAt        DateTime? // scheduled publication
  unpublishAt      DateTime?
  seo              Json?
  properties       Json? // free-form product properties usable as filter source
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  variants         ProductVariant[]
  images           ProductImage[]
  attributeValues  ProductAttributeValue[]
  tags             ProductTag[]
  collections      CollectionProduct[]
  reviews          Review[]
  couponLinks      CouponProduct[]

  @@index([status, publishAt])
  @@index([categoryId, status])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  mediaId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position  Int     @default(0)

  @@unique([productId, mediaId])
  @@index([mediaId])
}

model Attribute {
  id         String           @id @default(cuid())
  name       String // Color, Size, Author...
  slug       String           @unique
  type       String           @default("TEXT") // TEXT | COLOR | NUMBER
  usedForVariants Boolean     @default(false)
  isFilterable Boolean        @default(true)
  sortOrder  Int              @default(0)
  values     AttributeValue[]
}

model AttributeValue {
  id          String                  @id @default(cuid())
  attributeId String
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  slug        String
  meta        Json? // e.g. { hex: "#fff" }
  sortOrder   Int                     @default(0)
  variants    VariantAttributeValue[]
  products    ProductAttributeValue[]

  @@unique([attributeId, slug])
}

/// Non-variant attribute values on a product (e.g. Author, Material) — filterable.
model ProductAttributeValue {
  productId        String
  attributeValueId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

/// Every product has >= 1 variant. Simple products have one default variant.
model ProductVariant {
  id             String                  @id @default(cuid())
  productId      String
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String                  @unique
  barcode        String?
  title          String? // "Red / L"
  price          Decimal                 @db.Decimal(12, 2)
  compareAtPrice Decimal?                @db.Decimal(12, 2)
  cost           Decimal?                @db.Decimal(12, 2)
  weightGrams    Int?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  imageMediaId   String?
  isDefault      Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  position       Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  attributes     VariantAttributeValue[]
  inventory      InventoryItem?
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
}

model VariantAttributeValue {
  variantId        String
  attributeValueId String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

// ───────────────────────── Inventory ─────────────────────────

model InventoryItem {
  id                String              @id @default(cuid())
  variantId         String              @unique
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand            Int                 @default(0)
  reserved          Int                 @default(0)
  lowStockThreshold Int                 @default(5)
  trackInventory    Boolean             @default(true)
  allowBackorder    Boolean             @default(false)
  updatedAt         DateTime            @updatedAt
  movements         InventoryMovement[]
  // available = onHand - reserved (computed). DB CHECK constraints added in migration.
}

enum InventoryMovementType {
  ADJUSTMENT
  RESERVE
  RELEASE
  COMMIT // reserved -> sold (decrements onHand and reserved)
  RETURN
  RESTOCK
}

model InventoryMovement {
  id          String                @id @default(cuid())
  itemId      String
  item        InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        InventoryMovementType
  quantity    Int // signed delta applied to onHand for ADJUSTMENT/RESTOCK/RETURN; magnitude otherwise
  reason      String?
  orderId     String?
  actorId     String?
  onHandAfter Int
  reservedAfter Int
  createdAt   DateTime              @default(now())

  @@index([itemId, createdAt])
  @@index([orderId])
}

// ───────────────────────── Customers ─────────────────────────

model Customer {
  id            String             @id @default(cuid())
  email         String             @unique
  passwordHash  String? // null => guest-created record
  firstName     String?
  lastName      String?
  phone         String?
  isGuest       Boolean            @default(false)
  isActive      Boolean            @default(true)
  emailVerified Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  addresses     Address[]
  sessions      CustomerSession[]
  resetTokens   CustomerPasswordReset[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
}

model CustomerSession {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  familyId         String
  csrfToken        String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([customerId])
  @@index([familyId])
}

model CustomerPasswordReset {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String // ISO 3166-1 alpha-2
  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ───────────────────────── Cart / Coupons / Shipping methods ─────────────────────────

model Cart {
  id         String     @id @default(cuid())
  token      String     @unique // opaque anonymous cart token
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponCode String?
  currency   String
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([customerId])
  @@index([expiresAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([variantId])
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique // stored upper-case
  description      String?
  discountType     DiscountType
  value            Decimal            @db.Decimal(12, 2) // amount or percent
  minOrderAmount   Decimal?           @db.Decimal(12, 2)
  maxDiscount      Decimal?           @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int                @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  products         CouponProduct[]
  categories       CouponCategory[]
  redemptions      CouponRedemption[]
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId    String   @unique
  customerId String?
  email      String?
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
  @@index([couponId, email])
}

enum ShippingMethodType {
  FLAT
  FREE_OVER
  PROVIDER_RATE
}

model ShippingMethod {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  type            ShippingMethodType @default(FLAT)
  price           Decimal            @default(0) @db.Decimal(12, 2)
  freeOverAmount  Decimal?           @db.Decimal(12, 2)
  minDays         Int?
  maxDays         Int?
  countries       String[] // empty => everywhere
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
}

// ───────────────────────── Orders ─────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model OrderSequence {
  id    String @id @default("order")
  value Int    @default(0)
}

model Order {
  id               String         @id @default(cuid())
  orderNumber      String         @unique // human-readable, e.g. ORD-100023
  status           OrderStatus    @default(PENDING)
  paymentStatus    PaymentStatus  @default(PENDING)
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerSnapshot Json // { email, name, phone }
  email            String
  currency         String
  subtotal         Decimal        @db.Decimal(12, 2)
  discountTotal    Decimal        @default(0) @db.Decimal(12, 2)
  shippingTotal    Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal        @default(0) @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  taxBreakdown     Json?          // CGST/SGST/IGST or generic lines (snapshot)
  couponCode       String?
  shippingMethodCode String?
  shippingMethodName String?
  shippingAddress  Json
  billingAddress   Json
  paymentProvider  String?
  idempotencyKey   String?        @unique
  placedAt         DateTime       @default(now())
  cancelledAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            OrderItem[]
  events           OrderEvent[]
  notes            OrderNote[]
  payments         Payment[]
  shipments        Shipment[]
  invoice          Invoice?
  returns          ReturnRequest[]

  @@index([customerId])
  @@index([status, createdAt])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId    String?
  // immutable snapshots
  productTitle String
  variantTitle String?
  sku          String
  imageUrl     String?
  attributes   Json?
  unitPrice    Decimal         @db.Decimal(12, 2)
  quantity     Int
  discount     Decimal         @default(0) @db.Decimal(12, 2)
  taxRate      Decimal         @default(0) @db.Decimal(6, 3)
  taxAmount    Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal         @db.Decimal(12, 2)
  hsnCode      String?
  returnedQty  Int             @default(0)

  @@index([orderId])
  @@index([variantId])
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // STATUS_CHANGED | PAYMENT_PAID | NOTE | SHIPMENT_CREATED ...
  fromStatus OrderStatus?
  toStatus  OrderStatus?
  message   String?
  actorType String? // ADMIN | CUSTOMER | SYSTEM | WEBHOOK
  actorId   String?
  data      Json?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  refundedAmount    Decimal       @default(0) @db.Decimal(12, 2)
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  refunds           Refund[]

  @@unique([provider, providerOrderId])
  @@index([orderId])
  @@index([providerPaymentId])
}

/// Webhook replay protection: (provider, eventId) is unique.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payloadHash String
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model IdempotencyKey {
  key         String   @id
  scope       String
  requestHash String
  response    Json?
  statusCode  Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Shipment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String
  providerShipmentId String?
  awb            String?
  carrier        String?
  trackingUrl    String?
  status         String   @default("CREATED") // CREATED | IN_TRANSIT | DELIVERED | CANCELLED | FAILED
  trackingEvents Json?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([awb])
}

model InvoiceSequence {
  id    String @id @default("invoice")
  year  Int
  value Int    @default(0)
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoiceNumber String   @unique
  issuedAt      DateTime @default(now())
  data          Json // full immutable snapshot: seller, buyer, lines, tax breakdown
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CLOSED
}

model ReturnRequest {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status       ReturnStatus   @default(REQUESTED)
  reason       String
  details      String?
  refundAmount Decimal?       @db.Decimal(12, 2)
  decidedById  String?
  decisionNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        ReturnItem[]
  history      ReturnHistory[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id          String        @id @default(cuid())
  returnId    String
  return      ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  quantity    Int
  restock     Boolean       @default(false)

  @@index([returnId])
}

model ReturnHistory {
  id        String        @id @default(cuid())
  returnId  String
  return    ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  status    ReturnStatus
  note      String?
  actorId   String?
  createdAt DateTime      @default(now())

  @@index([returnId])
}

model Refund {
  id               String         @id @default(cuid())
  paymentId        String
  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnId         String?
  return           ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  amount           Decimal        @db.Decimal(12, 2)
  reason           String?
  providerRefundId String?
  status           String         @default("PENDING") // PENDING | PROCESSED | FAILED
  createdAt        DateTime       @default(now())

  @@index([paymentId])
  @@index([returnId])
}

// ───────────────────────── CMS / Navigation / Filters ─────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique // "home", "about", ...
  title     String
  status    ContentStatus @default(DRAFT)
  seo       Json?
  publishAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sections  PageSection[]
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String // HERO | PROMO_BANNER | TEXT | IMAGE | PRODUCT_GRID | CATEGORY_GRID | RICH_TEXT | REVIEWS | BLOG_PREVIEW | CUSTOM_JSON
  key       String? // optional stable key for storefront lookups
  content   Json // validated per type in API
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, sortOrder])
}

model NavigationMenu {
  id    String           @id @default(cuid())
  key   String           @unique // header | footer | custom
  name  String
  items NavigationItem[]
}

model NavigationItem {
  id           String           @id @default(cuid())
  menuId       String
  menu         NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[] @relation("NavTree")
  label        String
  type         String           @default("LINK") // LINK | CATEGORY | COLLECTION | PAGE | MEGA
  url          String?
  categoryId   String?
  collectionId String?
  pageSlug     String?
  badge        String?
  promo        Json? // promo card for mega menu { title, image, url, ... }
  showDesktop  Boolean          @default(true)
  showMobile   Boolean          @default(true)
  openInNewTab Boolean          @default(false)
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)

  @@index([menuId, parentId, sortOrder])
}

enum FilterSource {
  CATEGORY
  COLLECTION
  PRICE
  STOCK
  ATTRIBUTE
  TAG
  PROPERTY
}

model FilterGroup {
  id             String       @id @default(cuid())
  categoryId     String? // null => global default
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  source         FilterSource
  attributeId    String?
  propertyKey    String?
  label          String
  sortOrder      Int          @default(0)
  isEnabled      Boolean      @default(true)
  defaultOpen    Boolean      @default(true)
  multiSelect    Boolean      @default(true)
  showDesktop    Boolean      @default(true)
  showMobile     Boolean      @default(true)
  inheritToChildren Boolean   @default(true)

  @@index([categoryId, sortOrder])
}

// ───────────────────────── Reviews / Blog ─────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName         String
  authorEmail        String?
  rating             Int // 1..5 (CHECK in migration)
  title              String?
  body               String?
  status             ReviewStatus @default(PENDING)
  verifiedPurchase   Boolean      @default(false)
  moderationNote     String?
  createdAt          DateTime     @default(now())
  moderatedAt        DateTime?

  @@index([productId, status, createdAt])
  @@index([status])
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  body        String // sanitized HTML/markdown
  coverMediaId String?
  authorName  String?
  status      ContentStatus @default(DRAFT)
  publishAt   DateTime?
  seo         Json?
  tags        String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishAt])
}

// ───────────────────────── Notifications ─────────────────────────

model NotificationTemplate {
  id        String   @id @default(cuid())
  event     String // order.confirmation, password.reset ...
  channel   String   @default("EMAIL")
  subject   String
  body      String // handlebars-lite {{var}} template
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([event, channel])
}

model NotificationLog {
  id        String   @id @default(cuid())
  event     String
  channel   String
  recipient String
  status    String // SENT | FAILED | SKIPPED
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([recipient])
}

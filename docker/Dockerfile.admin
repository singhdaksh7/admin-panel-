# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/admin/package.json apps/admin/
COPY packages/database/package.json packages/database/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/provider-sdk/package.json packages/provider-sdk/
COPY packages/storefront-sdk/package.json packages/storefront-sdk/
COPY examples/demo-storefront/package.json examples/demo-storefront/
RUN npm ci
COPY . .
# Empty VITE_API_URL => admin calls the API on its own origin (/api/...), proxied by nginx below.
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build -w @kash-commerce/admin

FROM nginx:1.27-alpine
COPY docker/nginx.admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
EXPOSE 80

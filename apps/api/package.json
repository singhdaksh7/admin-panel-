{
  "name": "@kash-commerce/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node20 --clean --noExternal @kash-commerce/shared --noExternal @kash-commerce/config --noExternal @kash-commerce/contracts --noExternal @kash-commerce/provider-sdk --noExternal @kash-commerce/database",
    "start": "node dist/server.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@kash-commerce/config": "*",
    "@kash-commerce/contracts": "*",
    "@kash-commerce/database": "*",
    "@kash-commerce/provider-sdk": "*",
    "@kash-commerce/shared": "*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "image-size": "^1.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.16.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "sanitize-html": "^2.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.8",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5"
  }
}
